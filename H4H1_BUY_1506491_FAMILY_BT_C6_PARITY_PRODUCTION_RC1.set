; H4H1 BUY 1506491 RC3C PORTABLE v1.2 — AUREX GOLD GEOMETRY STANDARD
; 100 Gold points = 1.00 XAU price movement
; TP1 500 Gold points = 5.00 XAU price movement
; Account currency (USD/USC/Cent) is reporting only; no TP/BE account-profit trigger is used.
; RC3C TP1 PORTABILITY v1.0 — TP1 = 500 Aurex Gold points = $5.00 XAU PRICE MOVE
; Account currency independent: USD / USC / broker suffix / contract size do not change the TP1 market distance.
; RC3C crossed-LIMIT geometry safety fix only
InpB1RejectCollapsedLimitGeometry=true
InpB1MinFillToSL_ATR=0.20
InpB1MinFillToSLGoldPoints=100
; RC3B CAPACITY ACCOUNTING FIX ONLY — all strategy settings identical to RC3A
; RC3A compile correction only; strategy/settings identical to RC3
; RC3 EXECUTION-PARITY / GLOBAL MAX3 FIX — strategy parameters unchanged
; RC2 operational fix only: SOF correlation reconciliation + explicit BE-wait telemetry
; 1506491 FAMILY-B B1 PRODUCTION RC1 — smoke before live-demo
; v0.2 FIX: GRACE arm wired directly to Family-B candidate, independent of EPR
; AUREX H4H1 BUY 1506290 — ENTRY + TP/RUNNER SHADOW RESEARCH
; Real trading path: unchanged Family-B BUY STOP only
InpMagicNumber=1506491
InpV10EnableTrading=true
InpV10EnableLegacyEntries=false
InpV10TradeDirection=1
InpV10FamilyA_FirstConfirm=false
InpV10FamilyB_ContinuationBOS=true
InpV10FamilyC_RBRDBD=false
InpV10FamilyD_RecoveryConfirm=false
InpBRC_NoFixedTP=true
InpBRC_RequireBuyOnly=true
InpBRC_RequireFamilyBOnly=true
InpRC2EnforceRunnerATRTrail=true
InpPRME_TP1GoldPoints=500.0
InpPRME_PartialPct=50.0
InpPRME_BEBufferPoints=0.0
InpPRME_ATRTrailMult=1.50
InpEPRShadowEnable=false
